# Python environment
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# OpenVINO models — ~9 GB, reproducible from the export commands in docs/hardware_notes.md
models/

# OpenVINO compile caches
.npucache/
.ovcache/

# Corpus — PDFs and extracted text are not redistributed.
# corpus/manifest.csv is committed; the documents themselves are not.
corpus/raw/
corpus/extracted/
corpus/rejected/

# Derived corpus text. chunks.jsonl carries verbatim extracted text, including the
# personal data noted in README section 4 — it is not redistributed either.
corpus/chunks.jsonl

# The loaded eval set embeds gold passages copied from the extracted corpus, so it
# falls under the same rule. The public release is the questions plus manifest.csv
# (README section 4) — a passage-stripped export, not this file.
evalset/evalset_v1.jsonl

# Stage 3 passage->chunk map. Derived from both gitignored artifacts above.
evalset/passage_locations.jsonl

# Retriever artifacts — embeddings, FAISS and BM25 indexes. They embed corpus text
# (bm25.pkl stores the tokenised corpus outright), so they stay out of git and are
# rebuilt from chunks.jsonl via src/retrieval/build_index.py.
#
# Ignored by FILE PATTERN, not as a directory: git cannot re-include anything under an
# excluded directory, and the frozen retriever's contract — index/frozen/*/FREEZE.md
# and fixture.json — must stay trackable so the retriever-vN tag can pin it.
index/**/*.npy
index/**/*.index
index/**/*.pkl
index/**/*.jsonl
index/**/chunk_ids.json
index/*.json

# Experiment outputs
results/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch
*.tmp
*.log
filled_passages_batch*.md
